# Leave empty in production so the SPA uses same-origin /api on Render.
# Same-origin is required for the httpOnly admin session cookie.
VITE_API_BASE=

# Admin login (required in production)
# Set ADMIN_USER so login requires both username and password.
ADMIN_USER=
ADMIN_PASSWORD=
# Long random string (32+ characters) — signs the httpOnly qm_admin session cookie
JWT_SECRET=

# Supabase (required in production — secret key stays server-side only)
# Use the new secret key from Project Settings → API (sb_secret_...), not the legacy service_role JWT.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
